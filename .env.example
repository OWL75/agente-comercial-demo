# Postgres del proyecto Supabase compartido de Sistecomp (schema dedicado "agente_comercial").
# Conexión directa (no PostgREST) porque ese schema no está expuesto vía la API REST por defecto,
# y así evitamos exponerlo. Solo se usa del lado del servidor: el navegador nunca la ve.
# Obtenla en: Supabase Dashboard > Project Settings > Database > Connection string (URI, modo
# "Transaction pooler" recomendado para entornos serverless).
DATABASE_URL=

# OpenAI (agent runtime — Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Acceso a la demo (gate simple, sin sistema de usuarios)
DEMO_ACCESS_PASSWORD=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
