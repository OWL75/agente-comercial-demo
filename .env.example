# Postgres del proyecto Supabase compartido de Sistecomp (schema dedicado "agente_comercial").
# Conexión directa (no PostgREST) porque ese schema no está expuesto vía la API REST por defecto,
# y así evitamos exponerlo. Solo se usa del lado del servidor: el navegador nunca la ve.
# Obtenla en: Supabase Dashboard > Project Settings > Database > Connection string (URI, modo
# "Transaction pooler" recomendado para entornos serverless).
DATABASE_URL=

# OpenAI (agent runtime — Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Acceso a la demo (gate simple, sin sistema de usuarios)
DEMO_ACCESS_PASSWORD=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Business Cloud API (Meta) — número dedicado a este agente,
# separado del número del agente de soporte. Ver README para el paso a paso.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v26.0

# Número personal/de prueba que representará al cliente durante reuniones y videos.
# Formato internacional E.164 (por ejemplo: +50766123456). Este número debe abrir
# primero la ventana de atención escribiéndole al agente durante las 24 h previas.
DEMO_WHATSAPP_RECIPIENT=

# Modo de entrega de la estrategia de plantillas:
# - simulate: demo; envía el texto exacto sin botones dentro de la ventana abierta.
# - meta: producción; usa plantillas aprobadas fuera de la ventana de 24 h.
# - disabled: el agente genera aperturas y seguimientos como texto libre.
WHATSAPP_TEMPLATE_MODE=simulate
# Compatibilidad temporal: true equivale a WHATSAPP_TEMPLATE_MODE=meta.
WHATSAPP_TEMPLATES_ENABLED=false

# Optional live-model QA only: use a separately seeded test database, never production.
QA_DATABASE_URL=
QA_ALLOW_LIVE_MODEL=false
